# irx — secrets & runtime config.  Copy to .env and fill in. NEVER commit .env.

# ── Telegram (run from a VPS outside Iran: Telegram is censored in Iran) ──
# Bot token from @BotFather. The bot broadcasts to the whitelist and the
# listener service (irx_listener.py) uses the same token to receive messages.
TELEGRAM_BOT_TOKEN=
*** Owner's numeric chat id (message the bot, then getUpdates shows it).
OWNER_CHAT_ID=

# ── Market data (all free tiers) ──
# BrsAPI — Tehran street rates in Toman.  https://brsapi.ir (free key by email)
# NOTE: their firewall IP-bans python's default User-Agent; the tool spoofs a
# browser UA for this endpoint — keep it that way.
BRS_API_KEY=

*** ExchangeRate-API v6 — world USD crosses (CNY, AED) + IRR estimate. https://www.exchangerate-api.com
ERA_API_KEY=

# ── LLM insight (OPTIONAL — leave all three empty to disable insights) ──
# Any OpenAI-compatible /chat/completions endpoint.
# Suggested: Groq — https://api.groq.com/openai/v1  (model: openai/gpt-oss-20b)
# Alternative: OpenRouter — https://openrouter.ai/api/v1 (model: openai/gpt-oss-20b:free)
# NOTE: Cloudflare-protected endpoints reject the spoofed browser UA (error 1010);
# irx_brief sends an honest UA here on purpose.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MO…-20b
LLM_MAX_TOKENS=500
# how many intraday rows to feed the model as trend context
INSIGHT_TREND_N=12

# ── Schedule (the brief self-guards this window; make_crontab.py generates cron lines from it) ──
# times are Tehran wall clock (UTC+3:30); window is inclusive to the end hour
INTERVAL_MINUTES=30
WINDOW_START=7
WINDOW_END=22

# ── Alert thresholds (percent; ⚠ line appended when crossed) ──
ALERT_GAP_PCT=2.0
ALERT_GOLD_PCT=3.0
ALERT_COIN_PCT=8.0
